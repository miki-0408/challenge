Grammar

    0 $accept: program $end

    1 program: function_declaration_list

    2 function_declaration_list: function_declaration
    3                          | function_declaration_list function_declaration

    4 function_declaration: function
    5                     | declaration

    6 type_spec: INT
    7          | CHAR
    8          | STRUCT IDENTIFIER '{' field_decl_list '}'
    9          | STRUCT '{' field_decl_list '}'
   10          | STRUCT IDENTIFIER
   11          | TYPEID

   12 field_decl_list: field_decl
   13                | field_decl_list field_decl

   14 field_decl: type_spec field_var_list ';'

   15 field_var_list: field_var_unit
   16               | field_var_list ',' field_var_unit

   17 field_var_unit: IDENTIFIER
   18               | '*' IDENTIFIER
   19               | IDENTIFIER dims

   20 declaration: type_spec variable_list ';'
   21            | TYPEDEF type_spec IDENTIFIER ';'
   22            | TYPEDEF type_spec '*' IDENTIFIER ';'
   23            | TYPEDEF type_spec IDENTIFIER '[' INTEGER ']' ';'
   24            | type_spec ';'

   25 variable_list: var_unit
   26              | variable_list ',' var_unit

   27 var_unit: IDENTIFIER
   28         | '*' IDENTIFIER
   29         | IDENTIFIER dims

   30 dims: '[' INTEGER ']' dims
   31     | '[' INTEGER ']'

   32 function: type_spec function_head '(' parameter_list ')' block
   33         | error

   34 function_head: IDENTIFIER

   35 parameter_list: ε
   36               | param_seq

   37 param_seq: type_spec IDENTIFIER
   38          | type_spec '*' IDENTIFIER
   39          | type_spec IDENTIFIER '[' ']'
   40          | param_seq ',' type_spec IDENTIFIER
   41          | param_seq ',' type_spec '*' IDENTIFIER
   42          | param_seq ',' type_spec IDENTIFIER '[' ']'

   43 statement: assignment_statement ';'
   44          | input_statement ';'
   45          | output_statement ';'
   46          | call_statement ';'
   47          | return_statement ';'
   48          | if_statement
   49          | while_statement
   50          | do_while_statement
   51          | for_statement
   52          | switch_statement
   53          | block
   54          | BREAK ';'
   55          | CONTINUE ';'
   56          | error

   57 switch_statement: SWITCH '(' expression ')' '{' setup case_list '}'

   58 setup: ε

   59 case_list: ε
   60          | case_list case_item

   61 case_item: CASE INTEGER ':' statement_list
   62          | CASE INTEGER ':'
   63          | CASE CHARACTER ':' statement_list
   64          | CASE CHARACTER ':'
   65          | DEFAULT ':' statement_list
   66          | DEFAULT ':'

   67 block: '{' declaration_list statement_list '}'

   68 declaration_list: ε
   69                 | declaration_list declaration

   70 statement_list: statement
   71               | statement_list statement

   72 assignment_statement: IDENTIFIER '=' expression
   73                     | '*' expression '=' expression
   74                     | expression '[' expression ']' '=' expression
   75                     | expression '.' IDENTIFIER '=' expression
   76                     | expression ARROW IDENTIFIER '=' expression

   77 expression: expression '+' expression
   78           | expression '-' expression
   79           | expression '*' expression
   80           | expression '/' expression
   81           | '-' expression
   82           | '*' expression
   83           | '&' laddr
   84           | expression '[' expression ']'
   85           | expression '.' IDENTIFIER
   86           | expression ARROW IDENTIFIER
   87           | expression EQ expression
   88           | expression NE expression
   89           | expression LT expression
   90           | expression LE expression
   91           | expression GT expression
   92           | expression GE expression
   93           | expression AND expression
   94           | expression OR expression
   95           | '(' expression ')'
   96           | INTEGER
   97           | CHARACTER
   98           | IDENTIFIER
   99           | call_expression

  100 laddr: IDENTIFIER
  101      | laddr '[' expression ']'
  102      | laddr '.' IDENTIFIER
  103      | laddr ARROW IDENTIFIER

  104 argument_list: ε
  105              | expression_list

  106 expression_list: expression
  107                | expression_list ',' expression

  108 input_statement: INPUT IDENTIFIER

  109 output_statement: OUTPUT IDENTIFIER
  110                 | OUTPUT TEXT
  111                 | OUTPUT CHARACTER

  112 return_statement: RETURN expression

  113 if_statement: IF '(' expression ')' block
  114             | IF '(' expression ')' block ELSE block

  115 while_statement: WHILE '(' expression ')' block

  116 do_while_statement: DO block WHILE '(' expression ')' ';'

  117 for_statement: FOR '(' for_init ';' for_cond ';' for_iter ')' block

  118 for_init: assignment_statement
  119         | call_statement
  120         | ε

  121 for_cond: expression
  122         | ε

  123 for_iter: assignment_statement
  124         | call_statement
  125         | ε

  126 call_statement: IDENTIFIER '(' argument_list ')'

  127 call_expression: IDENTIFIER '(' argument_list ')'


